# Copy to .env and change before running anywhere other than a local sandbox.
# Both the Asterisk container (manager.conf) and the backend read these.
AMI_USERNAME=visualpbx
AMI_SECRET=replace-with-a-unique-local-value
# Exactly 32 random bytes encoded as Base64. Keep this key separately from
# ordinary backups; losing it makes encrypted SIP credentials unrecoverable.
PBX_MASTER_KEY=replace-with-32-byte-base64
PBX_ENV=development
PBX_SECURE_COOKIES=false
