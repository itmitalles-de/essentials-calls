    "verify-recovery": "node dist/cli/verifyRecovery.js"
  },
  "dependencies": {
    "@visual-pbx/shared": "*",
    "better-sqlite3": "13.0.3",
    "express": "^4.21.1",
    "helmet": "^8.3.0",
    "tar": "^7.5.22",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
