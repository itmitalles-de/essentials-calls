[general]
enabled = yes
port = 5038
bindaddr = 0.0.0.0
webenabled = no

; Credentials come from the AMI_USERNAME/AMI_SECRET environment variables and
; are substituted by entrypoint.sh at container start, so they are not baked
; into the image. `permit` restricts AMI to loopback and RFC1918 ranges, which
; covers the docker-compose network without exposing it further.
[__AMI_USERNAME__]
secret = __AMI_SECRET__
deny = 0.0.0.0/0.0.0.0
permit = 127.0.0.1/255.255.255.0
permit = 10.0.0.0/255.0.0.0
permit = 172.16.0.0/255.240.0.0
permit = 192.168.0.0/255.255.0.0
read = system,call,log,verbose,command,agent,user,config,dtmf,reporting,cdr,dialplan,originate
write = system,call,log,verbose,command,agent,user,config,dtmf,reporting,cdr,dialplan,originate
