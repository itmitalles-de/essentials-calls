{
  "name": "visual-pbx",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "npm@11.17.0",
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  },
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build:shared": "npm run build -w shared",
    "build": "npm run build -w shared && npm run build -w backend && npm run build -w frontend",
    "typecheck": "npm run build:shared && npm run typecheck -w backend && npm run typecheck -w frontend",
    "test": "npm run build:shared && npm run test -w shared && npm run test -w backend && npm run test -w frontend",
    "test:full-stack": "sh scripts/full-stack-acceptance.sh",
    "test:e2e": "sh scripts/browser-e2e.sh",
    "test:backup-restore": "sh scripts/backup-restore-acceptance.sh",
    "validate:compose-images": "sh scripts/validate-compose-images.sh",
    "scan:secrets": "sh scripts/secret-scan.sh",
    "sbom": "npm sbom --sbom-format=cyclonedx",
    "sbom:asterisk": "node scripts/asterisk-sbom.mjs",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
